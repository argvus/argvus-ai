#!/bin/sh
# Single entry point for the optional ARGVUS AI desktop integration.
set -eu
system=${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}
config=$system/launcher/config/config.rasi
if [ -r "$system/session/sh/bootstrap.sh" ]; then
  # shellcheck disable=SC1090,SC1091
  . "$system/session/sh/bootstrap.sh"
  config=$(paths_config launcher/config/config.rasi)
fi
translate() {
  argvus i18n get ai "$@"
}
message() {
  printf '%s\n' "$1" >&2
  rofi -config "$config" -e "$1" || :
}
# Queries never install or update tools. Claude installs only after selection.
resolve() {
  case "$1" in
    claude)
      mise_path=$(command -v mise) || return 1
      version=$(cd "${HOME:?}" && "$mise_path" ls --installed --json claude 2>/dev/null | jq -er 'last(.[] | select(.installed == true)) | .version // empty') || return 1
      executable=$(cd "${HOME:?}" && "$mise_path" which --tool "claude@$version" claude 2>/dev/null) || return 1
      ;;
    agy)
      executable=$(command -v agy) || executable=${HOME:?}/.local/bin/agy
      ;;
    hermes|kimi|cursor)
      command_name=$1
      [ "$1" != cursor ] || command_name=agent
      if [ "$1" = cursor ] && [ -x "${HOME:?}/.local/bin/agent" ]; then
        executable=$HOME/.local/bin/agent
      else
        executable=$(command -v "$command_name") || executable=${HOME:?}/.local/bin/$command_name
      fi
      ;;
    opencode|codex|qwen) executable=$(command -v "$1") || return 1 ;;
    *) return 1 ;;
  esac
  case "$executable" in /*) ;; *) return 1 ;; esac
  [ -f "$executable" ] && [ -x "$executable" ] || return 1
  printf '%s\n' "$executable"
}
available() {
  resolve "$1" >/dev/null
}
list() {
  for agent in opencode codex claude agy qwen hermes cursor kimi; do
    if available "$agent"; then printf '%s\n' "$agent"; fi
  done
}
menu_agents() {
  for agent in opencode codex agy qwen; do
    if available "$agent"; then printf '%s\n' "$agent"; fi
  done
  if command -v mise >/dev/null 2>&1; then printf 'claude\n'; fi
  if command -v curl >/dev/null 2>&1 && command -v bash >/dev/null 2>&1; then printf 'hermes\ncursor\nkimi\n'; else for agent in hermes cursor kimi; do if available "$agent"; then printf '%s\n' "$agent"; fi; done; fi
}
run_claude() {
  [ "$(id -u)" -ne 0 ] || { message "$(translate root_install)"; return 1; }
  if ! executable=$(resolve claude); then
    command -v mise >/dev/null 2>&1 || { message "$(translate mise_missing)"; return 1; }
    result=0
    (cd "${HOME:?}" && mise install claude) || result=$?
    if [ "$result" -ne 0 ]; then message "$(translate install_error)"; return "$result"; fi
    executable=$(resolve claude) || { message "$(translate install_error)"; return 1; }
  fi
  PATH="${executable%/*}:$PATH"
  export PATH
  exec "$executable"
}
run_external() {
  external_agent=$1
  [ "$(id -u)" -ne 0 ] || { message "$(translate root_install)"; return 1; }
  if ! executable=$(resolve "$external_agent"); then
    case "$external_agent" in
      hermes) url=https://hermes-agent.nousresearch.com/install.sh ;;
      cursor) url=https://cursor.com/install ;;
      kimi) url=https://code.kimi.com/kimi-code/install.sh ;;
      *) return 2 ;;
    esac
    installer=$(mktemp "${TMPDIR:-/tmp}/argvus-ai-install.XXXXXXXX") || { message "$(translate install_error)"; return 1; }
    if ! curl -fsSL "$url" -o "$installer"; then rm -f "$installer"; message "$(translate install_error)"; return 1; fi
    result=0
    bash "$installer" || result=$?
    rm -f "$installer"
    if [ "$result" -ne 0 ]; then message "$(translate install_error)"; return "$result"; fi
    executable=$(resolve "$external_agent") || { message "$(translate install_error)"; return 1; }
  fi
  PATH="${executable%/*}:$PATH"
  export PATH
  exec "$executable"
}
launch() {
  case "$1" in opencode|codex|claude|agy|qwen|hermes|cursor|kimi) agent=$1 ;; *) message "$(translate invalid)"; return 2 ;; esac
  if [ "$agent" = claude ] || [ "$agent" = hermes ] || [ "$agent" = cursor ] || [ "$agent" = kimi ]; then
    self=$(command -v "$0")
    run_action=run-external
    [ "$agent" != claude ] || run_action=run-claude
    if [ "$agent" = claude ]; then set -- "$self" "$run_action"; else set -- "$self" "$run_action" "$agent"; fi
    if argvus tui-terminal --class argvus-ai --term kitty --profile ai-agents --title "ARGVUS AI Agent" -- argvus tui-terminal --frame "AI Agent" "$(translate footer.close)" "$@"; then return 0; fi
    message "$(translate terminal_error)"
    return 1
  fi
  if ! executable=$(resolve "$agent"); then
    message "$(translate unavailable agent="$agent")"
    return 1
  fi
  if argvus tui-terminal --class argvus-ai --term kitty --profile ai-agents --title "ARGVUS AI Agent" -- argvus tui-terminal --frame "AI Agent" "$(translate footer.close)" "$executable"; then return 0; fi
  message "$(translate terminal_error)"
  return 1
}
case "${1:-menu}" in
  run-external) [ "$#" -eq 2 ] || exit 2; case "$2" in hermes|cursor|kimi) run_external "$2" ;; *) exit 2 ;; esac ;;
  run-claude) [ "$#" -eq 1 ] || exit 2; run_claude ;;
  status)
    [ "$#" -eq 1 ] || { [ "$#" -eq 2 ] && [ "$2" = --check ]; } || exit 2
    agents=$(menu_agents)
    if [ "${2:-}" = --check ]; then [ -n "$agents" ]; exit; fi
    if [ -z "$agents" ]; then printf '{"text":""}\n'; exit 0; fi
    jq -cn --arg tooltip "$(translate title)" '{text:"󰚩",tooltip:$tooltip}'
    ;;
  list) [ "$#" -eq 1 ] || exit 2; list ;;
  launch) [ "$#" -eq 2 ] || exit 2; launch "$2" ;;
  menu)
    [ "$#" -le 1 ] || exit 2
    agents=$(menu_agents | while IFS= read -r agent; do
      case "$agent" in opencode) printf 'OpenCode\n' ;; codex) printf 'OpenAI Codex\n' ;; claude) printf 'Claude Code\n' ;; agy) printf 'Google Antigravity\n' ;; qwen) printf 'Qwen Code\n' ;; hermes) printf 'Hermes\n' ;; cursor) printf 'Cursor CLI\n' ;; kimi) printf 'Kimi Code\n' ;; esac
    done)
    if [ -z "$agents" ]; then message "$(translate empty)"; exit 1; fi
    status=0
    selected=$(printf '%s\n' "$agents" | rofi -config "$config" -dmenu -i -no-custom -p "$(translate title)") || status=$?
    case "$status" in 0) ;; 1) exit 0 ;; *) message "$(translate menu_error)"; exit 1 ;; esac
    [ -n "$selected" ] || exit 0
    case "$selected" in
      OpenCode) launch opencode ;;
      "OpenAI Codex") launch codex ;;
      "Claude Code") launch claude ;;
      "Google Antigravity") launch agy ;;
      "Qwen Code") launch qwen ;;
      Hermes) launch hermes ;;
      "Cursor CLI") launch cursor ;;
      "Kimi Code") launch kimi ;;
      *) message "$(translate invalid)"; exit 2 ;;
    esac
    ;;
  *) message "$(translate usage)"; exit 2 ;;
esac
